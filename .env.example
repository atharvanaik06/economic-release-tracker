RESEARCH_DATA_ENVIRONMENT=development
RESEARCH_DATA_LOG_LEVEL=INFO
RESEARCH_DATA_DATABASE_URL=postgresql+psycopg://research_data:research_data@postgres:5432/research_data
# Add a real key only to your local .env file. Never commit provider credentials.
RESEARCH_DATA_FRED_API_KEY=
RESEARCH_DATA_PROVIDER_HTTP_TIMEOUT_SECONDS=15
RESEARCH_DATA_PROVIDER_HTTP_MAX_ATTEMPTS=3

